<%
  lab_name = AppSetting.get(:lab_name) || ENV.fetch('LAB_NAME', 'Check-in Expresso')
  content_for :title, "Check-in — #{@unit.name}"
%>

<div class="form-wrapper" id="checkin-form-wrapper">

  <!-- Welcome Header -->
  <div style="text-align: center; margin-bottom: 24px;">
    <div style="width: 56px; height: 56px; margin: 0 auto 12px; background: linear-gradient(135deg, #002b47, #23c0b5); border-radius: 16px; display: flex; align-items: center; justify-content: center; color: white; font-size: 24px; box-shadow: 0 4px 12px rgba(35, 192, 181, 0.25);">
      🏥
    </div>
    <h1 style="font-size: 19px; font-weight: 700; color: #0f172a; margin: 0 0 4px; line-height: 1.3;">
      Bem-vindo(a) ao Check-in Expresso
    </h1>
    <p style="font-size: 14px; font-weight: 600; color: #23c0b5; margin: 0 0 2px;">
      <%= lab_name %>
    </p>
    <p style="font-size: 12px; color: #64748b; margin: 0;">
      📍 <%= @unit.name %> <%= "(#{@unit.city})" if @unit.city.present? %>
    </p>
  </div>

  <!-- Progress Bar -->
  <div class="progress-bar-container">
    <div class="progress-track">
      <div class="progress-fill" id="progress-fill" style="width: 20%"></div>
    </div>
    <div class="progress-steps">
      <span class="step-dot active" data-step="1">1</span>
      <span class="step-dot" data-step="2">2</span>
      <span class="step-dot" data-step="3">3</span>
      <span class="step-dot" data-step="4">4</span>
      <span class="step-dot" data-step="5">5</span>
    </div>
    <p class="progress-label" id="progress-label">Tipo de Atendimento</p>
  </div>

  <%= form_with url: checkin_submit_path(token: @unit.token), method: :post,
                html: { id: 'checkin-form', enctype: 'multipart/form-data', novalidate: true } do |f| %>

    <input type="hidden" name="origem" value="<%= @origem %>">
    <input type="hidden" id="cidade_atendimento" name="cidade_atendimento" value="<%= @unit.city %>">

    <!-- ══════════════════════════════════════════════════════════
         STEP 1 — Escolha do Atendimento / Prioridade
    ═══════════════════════════════════════════════════════════════ -->
    <div class="form-step active" id="step-1">
      <div class="step-header">
        <div class="step-icon">🏷️</div>
        <h2 class="step-title">Tipo de Atendimento</h2>
        <p class="step-subtitle">Selecione a sua prioridade de atendimento</p>
      </div>

      <input type="hidden" id="prioridade" name="prioridade" value="geral">

      <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px;">
        <!-- Opção Geral -->
        <button type="button" class="priority-btn active" id="btn-prioridade-geral" onclick="selectPriority('geral')"
                style="display: flex; align-items: center; gap: 14px; padding: 16px; border: 2px solid #23c0b5; background: rgba(35, 192, 181, 0.06); border-radius: 16px; text-align: left; cursor: pointer; transition: all 0.2s;">
          <span style="font-size: 28px;">🟢</span>
          <div style="flex: 1;">
            <div style="font-size: 15px; font-weight: 700; color: #0f172a;">Geral</div>
            <div style="font-size: 12px; color: #64748b;">Atendimento padrão por ordem de chegada</div>
          </div>
          <span class="priority-check" style="font-size: 18px; color: #23c0b5;">✓</span>
        </button>

        <!-- Opção Preferencial -->
        <button type="button" class="priority-btn" id="btn-prioridade-preferencial" onclick="selectPriority('preferencial')"
                style="display: flex; align-items: center; gap: 14px; padding: 16px; border: 2px solid #e2e8f0; background: #ffffff; border-radius: 16px; text-align: left; cursor: pointer; transition: all 0.2s;">
          <span style="font-size: 28px;">🟡</span>
          <div style="flex: 1;">
            <div style="font-size: 15px; font-weight: 700; color: #0f172a;">Preferencial</div>
            <div style="font-size: 12px; color: #64748b;">Idosos (60+), Gestantes, PCD ou com crianças de colo</div>
          </div>
          <span class="priority-check" style="font-size: 18px; color: #23c0b5; display: none;">✓</span>
        </button>

        <!-- Opção Superprioridade 80+ -->
        <button type="button" class="priority-btn" id="btn-prioridade-superprioridade" onclick="selectPriority('superprioridade')"
                style="display: flex; align-items: center; gap: 14px; padding: 16px; border: 2px solid #e2e8f0; background: #ffffff; border-radius: 16px; text-align: left; cursor: pointer; transition: all 0.2s;">
          <span style="font-size: 28px;">🔵</span>
          <div style="flex: 1;">
            <div style="font-size: 15px; font-weight: 700; color: #0f172a;">Superprioridade (80+ anos)</div>
            <div style="font-size: 12px; color: #64748b;">Prioridade especial assegurada por lei federal</div>
          </div>
          <span class="priority-check" style="font-size: 18px; color: #23c0b5; display: none;">✓</span>
        </button>
      </div>

      <button type="button" class="btn-next" onclick="nextStep(1)">
        Próximo
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
    </div>

    <!-- ══════════════════════════════════════════════════════════
         STEP 2 — Senha de Atendimento (Física)
    ═══════════════════════════════════════════════════════════════ -->
    <div class="form-step" id="step-2">
      <div class="step-header">
        <div class="step-icon">🎟️</div>
        <h2 class="step-title">Sua Senha</h2>
        <p class="step-subtitle">Digite sua senha ou tire uma foto do papel impresso</p>
      </div>

      <div class="form-fields">
        <!-- Digitar Senha -->
        <div class="field-group">
          <label class="field-label" for="numero_senha">Número da Senha</label>
          <input class="field-input" type="text" id="numero_senha" name="numero_senha"
                 placeholder="Ex: G-042 ou P-015" autocomplete="off"
                 style="font-size: 18px; font-weight: 700; text-align: center; letter-spacing: 0.05em; text-transform: uppercase;">
          <p class="field-hint" style="font-size: 12px; color: #64748b; margin-top: 4px; text-align: center;">
            Digite o código impresso no papel do totem
          </p>
        </div>

        <div style="display: flex; align-items: center; gap: 12px; margin: 16px 0;">
          <div style="flex: 1; height: 1px; background: #e2e8f0;"></div>
          <span style="font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em;">ou</span>
          <div style="flex: 1; height: 1px; background: #e2e8f0;"></div>
        </div>

        <!-- Foto da Senha -->
        <div class="upload-area" id="upload-senha">
          <input type="file" id="foto_senha" name="foto_senha"
                 accept="image/*" class="upload-input"
                 onchange="previewImage(this, 'preview-senha')">
          <label for="foto_senha" class="upload-label">
            <div class="upload-icon">📷</div>
            <p class="upload-title">Tirar Foto do Papel da Senha</p>
            <p class="upload-hint">Nossa inteligência artificial identificará o número automaticamente</p>
          </label>
          <div class="upload-preview" id="preview-senha" style="display: none;">
            <img id="preview-senha-img" src="" alt="Preview da senha">
            <button type="button" class="preview-remove" onclick="removeImage('foto_senha', 'preview-senha')">✕ Remover</button>
          </div>
        </div>
      </div>

      <div class="step-nav">
        <button type="button" class="btn-back" onclick="prevStep(2)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
          Voltar
        </button>
        <button type="button" class="btn-next" onclick="nextStep(2)">
          Próximo
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════
         STEP 3 — Cobertura (Particular ou Convênio)
    ═══════════════════════════════════════════════════════════════ -->
    <div class="form-step" id="step-3">
      <div class="step-header">
        <div class="step-icon">🏥</div>
        <h2 class="step-title">Cobertura</h2>
        <p class="step-subtitle">Como será realizado o atendimento?</p>
      </div>

      <!-- Tipo selector -->
      <div class="coverage-selector">
        <button type="button" class="coverage-btn active" id="btn-particular"
                onclick="selectCoverage('particular')">
          <span class="coverage-icon">💳</span>
          <span class="coverage-label">Particular</span>
          <span class="coverage-desc">Pagamento próprio</span>
        </button>
        <button type="button" class="coverage-btn" id="btn-convenio"
                onclick="selectCoverage('convenio')">
          <span class="coverage-icon">🏷️</span>
          <span class="coverage-label">Convênio</span>
          <span class="coverage-desc">Plano de saúde</span>
        </button>
      </div>

      <input type="hidden" id="cobertura_tipo" name="cobertura_tipo" value="particular">

      <!-- Convênio fields (hidden by default) -->
      <div class="convenio-fields" id="convenio-fields" style="display: none;">
        <div class="field-group">
          <label class="field-label" for="convenio">Nome do Convênio <span class="required">*</span></label>
          <input class="field-input" type="text" id="convenio" name="convenio"
                 placeholder="Ex: Unimed, Bradesco Saúde, Cassi...">
        </div>

        <div class="field-row">
          <div class="field-group">
            <label class="field-label" for="plano">Plano</label>
            <input class="field-input" type="text" id="plano" name="plano"
                   placeholder="Ex: Especial, Básico...">
          </div>
          <div class="field-group">
            <label class="field-label" for="numero_carteira">Nº Carteira</label>
            <input class="field-input" type="text" id="numero_carteira" name="numero_carteira"
                   placeholder="Número da carteira">
          </div>
        </div>

        <!-- Upload carteira convênio -->
        <div class="upload-area" id="upload-carteira">
          <input type="file" id="carteira_convenio" name="carteira_convenio"
                 accept="image/*,application/pdf" class="upload-input"
                 onchange="previewImage(this, 'preview-carteira')">
          <label for="carteira_convenio" class="upload-label">
            <div class="upload-icon">📷</div>
            <p class="upload-title">Foto da Carteirinha</p>
            <p class="upload-hint">Toque para tirar foto ou escolher arquivo</p>
          </label>
          <div class="upload-preview" id="preview-carteira" style="display: none;">
            <img id="preview-carteira-img" src="" alt="Preview carteirinha">
            <button type="button" class="preview-remove" onclick="removeImage('carteira_convenio', 'preview-carteira')">✕ Remover</button>
          </div>
        </div>
      </div>

      <div class="step-nav">
        <button type="button" class="btn-back" onclick="prevStep(3)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
          Voltar
        </button>
        <button type="button" class="btn-next" onclick="nextStep(3)">
          Próximo
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════
         STEP 4 — Pedido Médico & Documento
    ═══════════════════════════════════════════════════════════════ -->
    <div class="form-step" id="step-4">
      <div class="step-header">
        <div class="step-icon">📋</div>
        <h2 class="step-title">Pedido Médico</h2>
        <p class="step-subtitle">Envie fotos do pedido do seu médico (suporta várias folhas)</p>
      </div>

      <div class="upload-area" id="upload-requisicao">
        <input type="file" id="requisicao_camera" name="requisicoes_medicas[]"
               accept="image/*" capture="environment" class="upload-input" style="display:none"
               onchange="accumulateImage(this, 'preview-requisicao')">
        <input type="file" id="requisicao_arquivo" name="requisicoes_medicas[]"
               accept="image/*,application/pdf" multiple class="upload-input" style="display:none"
               onchange="accumulateImages(this, 'preview-requisicao')">

        <label class="upload-label" id="label-requisicao">
          <div class="upload-icon">📄</div>
          <p class="upload-title">Fotos do Pedido Médico</p>
          <p class="upload-hint">Tire uma foto clara de cada folha do pedido</p>
          <div style="display: flex; gap: 8px; margin-top: 12px; justify-content: center; flex-wrap: wrap;">
            <button type="button" onclick="event.preventDefault(); document.getElementById('requisicao_camera').click()"
                    style="padding: 10px 18px; border: 1.5px solid #23c0b5; border-radius: 10px; font-size: 13px; font-weight: 700; color: #23c0b5; background: transparent; cursor: pointer;">
              📷 Tirar Foto
            </button>
            <button type="button" onclick="event.preventDefault(); document.getElementById('requisicao_arquivo').click()"
                    style="padding: 10px 18px; border: 1.5px solid #23c0b5; border-radius: 10px; font-size: 13px; font-weight: 700; color: #23c0b5; background: transparent; cursor: pointer;">
              📂 Galeria / Arquivo
            </button>
          </div>
          <span class="upload-optional" style="margin-top: 10px;">Suporta múltiplas páginas</span>
        </label>

        <div class="upload-preview" id="preview-requisicao" style="display: none;">
          <p style="font-size: 13px; font-weight: 700; color: #002b47; margin-bottom: 8px;" id="preview-requisicao-count"></p>
          <div id="preview-requisicao-container" style="display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-bottom: 12px;"></div>
          <div style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap;">
            <button type="button" onclick="event.preventDefault(); document.getElementById('requisicao_camera').click()"
                    style="padding: 6px 14px; border: 1.5px solid #23c0b5; border-radius: 8px; font-size: 12px; font-weight: 600; color: #23c0b5; background: transparent; cursor: pointer;">
              📷 + Mais Foto
            </button>
            <button type="button" onclick="event.preventDefault(); document.getElementById('requisicao_arquivo').click()"
                    style="padding: 6px 14px; border: 1.5px solid #23c0b5; border-radius: 8px; font-size: 12px; font-weight: 600; color: #23c0b5; background: transparent; cursor: pointer;">
              📂 + Mais Arquivo
            </button>
            <button type="button" class="preview-remove" onclick="removeAllRequisicoes()">✕ Remover Todos</button>
          </div>
        </div>
      </div>

      <!-- Documento (RG / CNH) -->
      <div class="upload-area" id="upload-documento" style="margin-top: 24px;">
        <input type="file" id="documento" name="documento"
               accept="image/*,application/pdf" class="upload-input"
               onchange="previewImage(this, 'preview-documento')">
        <label for="documento" class="upload-label">
          <div class="upload-icon">🪪</div>
          <p class="upload-title">Documento com Foto (RG ou CNH)</p>
          <p class="upload-hint">Toque para tirar foto ou escolher arquivo</p>
          <span class="upload-optional">Opcional — agiliza ainda mais a conferência</span>
        </label>
        <div class="upload-preview" id="preview-documento" style="display: none;">
          <img id="preview-documento-img" src="" alt="Preview documento de identidade">
          <button type="button" class="preview-remove" onclick="removeImage('documento', 'preview-documento')">✕ Remover</button>
        </div>
      </div>

      <div class="step-nav">
        <button type="button" class="btn-back" onclick="prevStep(4)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
          Voltar
        </button>
        <button type="button" class="btn-next" onclick="nextStep(4)">
          Próximo
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════
         STEP 5 — Confirmação e Envio
    ═══════════════════════════════════════════════════════════════ -->
    <div class="form-step" id="step-5">
      <div class="step-header">
        <div class="step-icon">✅</div>
        <h2 class="step-title">Confirmar Check-in</h2>
        <p class="step-subtitle">Revise os dados antes de finalizar</p>
      </div>

      <div class="review-card">
        <h3 class="review-section-title">Atendimento</h3>
        <div class="review-row"><span class="review-key">Prioridade</span><span class="review-val" id="review-prioridade">Geral</span></div>
        <div class="review-row"><span class="review-key">Senha Retirada</span><span class="review-val" id="review-senha">—</span></div>
        <div class="review-row"><span class="review-key">Unidade</span><span class="review-val"><%= @unit.name %></span></div>
      </div>

      <div class="review-card">
        <h3 class="review-section-title">Cobertura</h3>
        <div class="review-row"><span class="review-key">Tipo</span><span class="review-val" id="review-cobertura">Particular 💳</span></div>
        <div id="review-convenio-details" style="display: none;">
          <div class="review-row"><span class="review-key">Convênio</span><span class="review-val" id="review-convenio-nome">—</span></div>
          <div class="review-row"><span class="review-key">Carteirinha</span><span class="review-val" id="review-carteira-status">—</span></div>
        </div>
      </div>

      <div class="review-card">
        <h3 class="review-section-title">Documentos Anexados</h3>
        <div class="review-row"><span class="review-key">Pedido Médico</span><span class="review-val" id="review-pedido-status">—</span></div>
        <div class="review-row"><span class="review-key">Documento de Identidade</span><span class="review-val" id="review-documento-status">—</span></div>
      </div>

      <div class="step-nav">
        <button type="button" class="btn-back" onclick="prevStep(5)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
          Voltar
        </button>
        <button type="submit" class="btn-submit" id="btn-submit">
          Confirmar Check-in
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 13l4 4L19 7"/></svg>
        </button>
      </div>
    </div>

  <% end %>

</div>

<script>
let currentStep = 1;
const totalSteps = 5;

const stepLabels = {
  1: 'Tipo de Atendimento',
  2: 'Senha do Totem',
  3: 'Cobertura',
  4: 'Pedido Médico',
  5: 'Confirmação'
};

function showStep(step) {
  document.querySelectorAll('.form-step').forEach(el => el.classList.remove('active'));
  document.getElementById(`step-${step}`)?.classList.add('active');

  const pct = ((step - 1) / (totalSteps - 1)) * 100;
  document.getElementById('progress-fill').style.width = `${Math.max(10, pct)}%`;

  document.querySelectorAll('.step-dot').forEach(dot => {
    const s = parseInt(dot.dataset.step);
    dot.classList.toggle('active', s === step);
    dot.classList.toggle('completed', s < step);
  });

  const labelEl = document.getElementById('progress-label');
  if (labelEl) labelEl.textContent = stepLabels[step] || '';

  if (step === 5) buildReview();

  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function nextStep(current) {
  currentStep = current + 1;
  showStep(currentStep);
}

function prevStep(current) {
  currentStep = current - 1;
  showStep(currentStep);
}

// ────────────────────────────────────────────────────────────────
// Prioridade Selector
function selectPriority(tipo) {
  document.getElementById('prioridade').value = tipo;
  document.querySelectorAll('.priority-btn').forEach(btn => {
    btn.style.borderColor = '#e2e8f0';
    btn.style.background = '#ffffff';
    const check = btn.querySelector('.priority-check');
    if (check) check.style.display = 'none';
  });

  const activeBtn = document.getElementById(`btn-prioridade-${tipo}`);
  if (activeBtn) {
    activeBtn.style.borderColor = '#23c0b5';
    activeBtn.style.background = 'rgba(35, 192, 181, 0.06)';
    const check = activeBtn.querySelector('.priority-check');
    if (check) check.style.display = 'inline';
  }
}

// ────────────────────────────────────────────────────────────────
// Coverage Selector
function selectCoverage(tipo) {
  document.getElementById('cobertura_tipo').value = tipo;
  document.getElementById('btn-particular').classList.toggle('active', tipo === 'particular');
  document.getElementById('btn-convenio').classList.toggle('active', tipo === 'convenio');

  const fields = document.getElementById('convenio-fields');
  if (tipo === 'convenio') {
    fields.style.display = 'block';
  } else {
    fields.style.display = 'none';
  }
}

// ────────────────────────────────────────────────────────────────
// Single Image Preview
function previewImage(input, previewId) {
  const preview = document.getElementById(previewId);
  const img = document.getElementById(`${previewId}-img`);
  const label = input.closest('.upload-area').querySelector('.upload-label');

  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = e => {
      if (img) img.src = e.target.result;
      preview.style.display = 'block';
      label.style.display = 'none';
    };
    reader.readAsDataURL(input.files[0]);
  }
}

function removeImage(inputId, previewId) {
  const input = document.getElementById(inputId);
  const preview = document.getElementById(previewId);
  const label = input.closest('.upload-area').querySelector('.upload-label');

  input.value = '';
  preview.style.display = 'none';
  label.style.display = 'flex';
}

// ────────────────────────────────────────────────────────────────
// Multi-photo accumulator for Pedido Médico
const _requisicaoDT = new DataTransfer();

function _renderRequisicoesPreview() {
  const preview   = document.getElementById('preview-requisicao');
  const container = document.getElementById('preview-requisicao-container');
  const label     = document.getElementById('label-requisicao');
  const countEl   = document.getElementById('preview-requisicao-count');
  const total     = _requisicaoDT.files.length;

  if (total === 0) {
    preview.style.display = 'none';
    label.style.display   = 'flex';
    return;
  }

  preview.style.display = 'block';
  label.style.display   = 'none';
  countEl.textContent   = `${total} página(s) adicionada(s)`;

  container.innerHTML = '';
  Array.from(_requisicaoDT.files).forEach((file, i) => {
    const wrapper = document.createElement('div');
    wrapper.style.cssText = 'position:relative;display:inline-block;';

    if (file.type.startsWith('image/')) {
      const reader = new FileReader();
      reader.onload = e => {
        const img = document.createElement('img');
        img.src = e.target.result;
        img.style.cssText = 'max-height:100px;border-radius:6px;border:1px solid #cbd5e1;display:block;';
        img.title = file.name;
        wrapper.appendChild(img);
      };
      reader.readAsDataURL(file);
    } else {
      const icon = document.createElement('div');
      icon.style.cssText = 'width:80px;height:100px;border:1px solid #cbd5e1;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:30px;background:#f8fafc;';
      icon.textContent = '📄';
      icon.title = file.name;
      wrapper.appendChild(icon);
    }

    const badge = document.createElement('span');
    badge.style.cssText = 'position:absolute;top:2px;right:2px;background:#002b47;color:white;border-radius:999px;font-size:9px;font-weight:700;padding:1px 5px;';
    badge.textContent = i + 1;
    wrapper.appendChild(badge);

    container.appendChild(wrapper);
  });
}

function accumulateImage(input, previewId) {
  if (!input.files || input.files.length === 0) return;
  _requisicaoDT.items.add(input.files[0]);
  input.value = '';
  _renderRequisicoesPreview();
}

function accumulateImages(input, previewId) {
  if (!input.files || input.files.length === 0) return;
  Array.from(input.files).forEach(f => _requisicaoDT.items.add(f));
  input.value = '';
  _renderRequisicoesPreview();
}

function removeAllRequisicoes() {
  while (_requisicaoDT.items.length > 0) _requisicaoDT.items.remove(0);
  _renderRequisicoesPreview();
  document.getElementById('preview-requisicao-container').innerHTML = '';
}

// Before form submit, inject accumulated files
document.addEventListener('DOMContentLoaded', () => {
  const form = document.getElementById('checkin-form');
  if (!form) return;
  form.addEventListener('submit', function(e) {
    if (_requisicaoDT.files.length > 0) {
      const camInput = document.getElementById('requisicao_camera');
      const arqInput = document.getElementById('requisicao_arquivo');
      camInput.files = _requisicaoDT.files;
      arqInput.disabled = true;
    }
  }, { capture: true });
});

// ────────────────────────────────────────────────────────────────
// Review / Summary Builder
function buildReview() {
  const val = id => document.getElementById(id)?.value || '';
  const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v || '—'; };

  const prioMap = {
    'geral': '🟢 Geral',
    'preferencial': '🟡 Preferencial (60+, Gestante, PCD)',
    'superprioridade': '🔵 Superprioridade (80+ anos)'
  };
  set('review-prioridade', prioMap[val('prioridade')] || 'Geral');

  const fotoSenhaInput = document.getElementById('foto_senha');
  const senhaDigitada = val('numero_senha');
  if (senhaDigitada) {
    set('review-senha', senhaDigitada.toUpperCase());
  } else if (fotoSenhaInput && fotoSenhaInput.files.length > 0) {
    set('review-senha', '📷 Foto anexada (identificação automática)');
  } else {
    set('review-senha', '(não informada)');
  }

  const tipo = val('cobertura_tipo');
  set('review-cobertura', tipo === 'convenio' ? 'Convênio 🏷️' : 'Particular 💳');

  const convDetails = document.getElementById('review-convenio-details');
  if (tipo === 'convenio') {
    convDetails.style.display = 'block';
    set('review-convenio-nome', val('convenio') || '(não informado)');
    const cartInput = document.getElementById('carteira_convenio');
    set('review-carteira-status', cartInput.files.length > 0 ? '📷 Foto anexada ✅' : '(não enviada)');
  } else {
    convDetails.style.display = 'none';
  }

  const pedidoCount = _requisicaoDT.files.length;
  set('review-pedido-status', pedidoCount > 0 ? `📄 ${pedidoCount} folha(s) anexada(s) ✅` : '(não enviada)');

  const docInput = document.getElementById('documento');
  set('review-documento-status', docInput.files.length > 0 ? '🪪 Foto anexada ✅' : '(não enviada)');
}
</script>
