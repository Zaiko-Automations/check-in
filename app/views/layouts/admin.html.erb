<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? yield(:title) : "Painel | Check-in Expresso" %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              DEFAULT: '#002b47',
              hover: '#001f33'
            },
            secondary: {
              DEFAULT: '#23c0b5',
              hover: '#1ca39a'
            }
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            heading: ['Outfit', 'sans-serif']
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    h1, h2, h3, h4, .font-heading { font-family: 'Outfit', sans-serif; }
    
    /* Legacy / Backwards Compatibility styles */
    .card { background: white; border: 1px solid #e2e8f0; border-radius: 16px; padding: 24px; box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1); }
    .btn { background: #002b47; color: white; padding: 10px 20px; border-radius: 12px; font-size: 14px; font-weight: 600; border: none; cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; justify-content: center; }
    .btn:hover { background: #001f33; }
    .btn-outline { background: white; border: 1px solid #cbd5e1; color: #334155; }
    .btn-outline:hover { background: #f8fafc; }
    
    .form-group { margin-bottom: 20px; }
    .form-label { display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.05em; }
    .form-control { width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 10px; font-size: 14px; outline: none; transition: border-color 0.2s; }
    .form-control:focus { border-color: #23c0b5; box-shadow: 0 0 0 3px rgba(35, 192, 181, 0.15); }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex">

  <!-- Sidebar -->
  <aside class="w-64 bg-white border-r border-slate-200 flex flex-col h-screen fixed top-0 left-0 z-40">
    <!-- Brand / Logo -->
    <div class="h-16 px-6 border-b border-slate-100 flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-primary to-secondary flex items-center justify-center font-bold text-white shadow-sm font-heading">
        C
      </div>
      <div class="min-w-0 flex-1">
        <h2 class="text-sm font-bold text-slate-800 tracking-tight leading-tight uppercase truncate">
          <%= AppSetting.get(:lab_name) || ENV.fetch('LAB_NAME', 'Check-in Expresso') %>
        </h2>
        <span class="text-[10px] text-secondary font-semibold tracking-wide uppercase">Painel Administrativo</span>
      </div>
    </div>

    <!-- Navigation -->
    <nav class="flex-grow p-4 space-y-1">
      <a href="<%= admin_root_path %>" class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all <%= controller_name == 'dashboard' || controller_name == 'walk_ins' ? 'bg-secondary/10 text-secondary font-bold' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
        <span>📋</span> Fila de Pedidos
      </a>
      <a href="<%= admin_units_path %>" class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all <%= controller_name == 'units' ? 'bg-secondary/10 text-secondary font-bold' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
        <span>🏢</span> Unidades
      </a>
      <a href="<%= admin_users_path %>" class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all <%= controller_name == 'users' ? 'bg-secondary/10 text-secondary font-bold' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
        <span>👥</span> Usuários
      </a>
      <a href="<%= edit_admin_settings_path %>" class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all <%= controller_name == 'settings' ? 'bg-secondary/10 text-secondary font-bold' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
        <span>⚙️</span> Configurações
      </a>
    </nav>

    <!-- User / Profile -->
    <div class="p-4 border-t border-slate-100 bg-slate-50/50">
      <div class="flex items-center justify-between gap-2">
        <div class="flex flex-col min-w-0">
          <span class="text-xs font-bold text-slate-700 truncate"><%= current_user&.email %></span>
          <% if current_user&.unit %>
            <span class="text-[10px] text-secondary font-medium truncate"><%= current_user.unit.name %></span>
          <% else %>
            <span class="text-[10px] text-slate-400 font-medium truncate">Acesso Geral</span>
          <% end %>
        </div>
        <%= button_to destroy_user_session_path, method: :delete, class: "p-1.5 text-slate-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-colors border border-transparent hover:border-red-100 cursor-pointer" do %>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
        <% end %>
      </div>
    </div>
  </aside>

  <!-- Main Content Area -->
  <div class="flex-grow pl-64 flex flex-col min-h-screen">
    <main class="flex-grow p-8 flex flex-col w-full">
      <%= yield %>
    </main>
  </div>

</body>
</html>
