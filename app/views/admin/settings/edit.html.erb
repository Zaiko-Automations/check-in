<% content_for :page_title, "Configurações" %>

<div class="page-header" style="margin-bottom: 24px;">
  <p class="page-subtitle" style="font-size: 0.9rem; color: #64748b; margin: 0;">Configure a integração do Check-in Expresso com seu sistema</p>
</div>

<% if notice %>
  <div class="alert alert-success" style="margin-bottom: 24px; padding: 16px 20px; background: rgba(35,192,181,0.15); border: 1px solid #23c0b5; border-radius: 12px; color: #23c0b5; font-weight: 500;">
    ✅ <%= notice %>
  </div>
<% end %>

<%= form_with url: admin_settings_path, method: :patch, local: true do |f| %>
  <div style="display: grid; gap: 32px; max-width: 720px;">

    <%# ── IDENTIDADE ─────────────────────────────── %>
    <div class="card">
      <div class="card-header">
        <h2 style="font-size: 1.1rem; font-weight: 600; color: var(--text-primary); margin: 0;">
          🏥 Identidade do Laboratório
        </h2>
      </div>
      <div class="card-body" style="padding: 24px; display: grid; gap: 20px;">
        <div class="form-group">
          <label class="form-label" for="lab_name">Nome do Laboratório</label>
          <input
            type="text"
            id="lab_name"
            name="lab_name"
            class="form-control"
            value="<%= @lab_name %>"
            placeholder="Ex: Laboratório Centro"
          >
        </div>
      </div>
    </div>

    <%# ── WEBHOOK ─────────────────────────────────── %>
    <div class="card">
      <div class="card-header">
        <h2 style="font-size: 1.1rem; font-weight: 600; color: var(--text-primary); margin: 0;">
          🔗 Integração via Webhook
        </h2>
      </div>
      <div class="card-body" style="padding: 24px; display: grid; gap: 20px;">

        <div class="form-group">
          <label class="form-label" for="webhook_url">URL do Webhook</label>
          <input
            type="url"
            id="webhook_url"
            name="webhook_url"
            class="form-control"
            value="<%= @webhook_url %>"
            placeholder="https://n8n.suaempresa.com.br/webhook/checkin"
          >
        </div>

        <div class="form-group">
          <label class="form-label" for="webhook_auth">
            Authorization Header
            <span style="color: var(--text-muted); font-weight: 400; font-size: 0.8rem;">(opcional)</span>
          </label>
          <input
            type="text"
            id="webhook_auth"
            name="webhook_auth"
            class="form-control"
            value="<%= @webhook_auth %>"
            placeholder="Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
            autocomplete="off"
          >
        </div>

      </div>
    </div>

    <%# ── MODO DE CONFERÊNCIA ────────────────────── %>
    <div class="card">
      <div class="card-header">
        <h2 style="font-size: 1.1rem; font-weight: 600; color: var(--text-primary); margin: 0;">
          🔄 Fluxo de Atendimento e Conferência
        </h2>
      </div>
      <div class="card-body" style="padding: 24px; display: grid; gap: 16px;">
        <label style="display: flex; items-center; gap: 12px; cursor: pointer; user-select: none;">
          <input type="hidden" name="enable_conference" value="0">
          <input
            type="checkbox"
            name="enable_conference"
            value="1"
            <%= "checked" if @enable_conference %>
            style="width: 20px; height: 20px; accent-color: #23c0b5; cursor: pointer; margin-top: 2px;"
          >
          <div>
            <div style="font-weight: 600; font-size: 0.95rem; color: #1e293b;">
              Ativar Tela / Fila de Conferência Manual
            </div>
            <p style="font-size: 0.85rem; color: #64748b; margin: 4px 0 0 0; line-height: 1.4;">
              <strong>Marcado (Padrão):</strong> Os check-ins recebidos são enviados para extração e ficam na fila de conferência para validação manual dos atendentes antes de despachar ao LIS.<br>
              <strong>Desmarcado (Envio Direto):</strong> Ao finalizar o check-in, os dados são enviados imediatamente para o Webhook final cadastrado acima, sem reter na fila de conferência.
            </p>
          </div>
        </label>
      </div>
    </div>

    <%# ── AÇÕES ───────────────────────────────────── %>
    <div style="display: flex; justify-content: flex-end;">
      <button type="submit" class="btn btn-primary" style="padding: 14px 32px; font-size: 1rem;">
        💾 Salvar Configurações
      </button>
    </div>

  </div>
<% end %>
