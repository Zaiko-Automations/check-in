<% content_for :page_title, "Unidade: #{@unit.name}" %>

<div class="w-full flex-grow flex flex-col">
  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
    <div class="flex items-center gap-3">
      <%= link_to admin_units_path, class: "px-4 py-2 bg-white hover:bg-slate-50 text-slate-700 text-sm font-semibold rounded-xl border border-slate-300 transition-colors shadow-sm cursor-pointer" do %>
        ← Voltar
      <% end %>
      <div>
        <h2 class="text-2xl font-bold text-slate-800 tracking-tight font-heading"><%= @unit.name %></h2>
        <p class="text-sm text-slate-500 mt-0.5">Detalhes da filial, link público e QR Code para balcão.</p>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <%= link_to edit_admin_unit_path(@unit), class: "inline-flex items-center gap-2 px-4 py-2.5 bg-white hover:bg-slate-50 text-slate-700 text-sm font-semibold rounded-xl border border-slate-300 transition-all shadow-sm cursor-pointer" do %>
        <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
        <span>Editar Unidade</span>
      <% end %>
    </div>
  </div>

  <% if notice %>
    <div class="mb-6 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm font-semibold flex items-center justify-between">
      <span>✅ <%= notice %></span>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left: Info & URL -->
    <div class="lg:col-span-7 bg-white rounded-2xl p-6 border border-slate-200 shadow-sm space-y-6">
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-secondary mb-4 border-b border-slate-100 pb-2">Informações da Filial</h3>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <span class="block text-xs text-slate-400 font-bold uppercase">Nome</span>
            <span class="text-sm font-bold text-slate-800"><%= @unit.name %></span>
          </div>
          <div>
            <span class="block text-xs text-slate-400 font-bold uppercase">Status</span>
            <% if @unit.active? %>
              <span class="inline-flex items-center px-2 py-0.5 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-full text-xs font-bold mt-0.5">
                Ativa
              </span>
            <% else %>
              <span class="inline-flex items-center px-2 py-0.5 bg-red-50 text-red-700 border border-red-200 rounded-full text-xs font-bold mt-0.5">
                Inativa
              </span>
            <% end %>
          </div>
          <div>
            <span class="block text-xs text-slate-400 font-bold uppercase">Endereço</span>
            <span class="text-sm text-slate-700 font-medium"><%= @unit.address.presence || 'Não informado' %></span>
          </div>
          <div>
            <span class="block text-xs text-slate-400 font-bold uppercase">Cidade</span>
            <span class="text-sm text-slate-700 font-medium"><%= @unit.city.presence || 'Não informada' %></span>
          </div>
        </div>
      </div>

      <div class="pt-4 border-t border-slate-100">
        <h3 class="text-xs font-bold uppercase tracking-wider text-secondary mb-3">Link Direto de Check-in</h3>
        <p class="text-xs text-slate-500 mb-2">Este link pode ser enviado para pacientes ou aberto em tablets de autoatendimento:</p>
        
        <div class="flex items-center gap-2">
          <input type="text" value="<%= @unit.checkin_url(host: request.host_with_port) %>" readonly id="unit-url-input" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono text-slate-700 focus:outline-none select-all">
          <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('unit-url-input').value); this.innerText = 'Copiado!'; setTimeout(() => this.innerText = 'Copiar', 2000);" class="shrink-0 px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-white rounded-xl text-xs font-bold transition-colors cursor-pointer">
            Copiar Link
          </button>
        </div>
      </div>
    </div>

    <!-- Right: QR Code -->
    <div class="lg:col-span-5 bg-white rounded-2xl p-6 border border-slate-200 shadow-sm text-center">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-4">QR Code para Recepção</h3>
      
      <div class="p-4 bg-slate-50 border border-slate-200 rounded-2xl inline-block shadow-inner mx-auto mb-4">
        <div class="bg-white p-3 rounded-xl border border-slate-100">
          <%= raw @qr_svg %>
        </div>
      </div>
      
      <p class="text-xs text-slate-500 max-w-xs mx-auto mb-4">
        Imprima e coloque este QR Code na bancada de atendimento da unidade para o paciente escanear pelo celular.
      </p>

      <button type="button" onclick="window.print()" class="w-full py-2.5 px-4 bg-primary hover:bg-primary-hover text-white text-sm font-semibold rounded-xl transition-all shadow-sm cursor-pointer flex items-center justify-center gap-2">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>
        <span>Imprimir QR Code</span>
      </button>
    </div>
  </div>
</div>
