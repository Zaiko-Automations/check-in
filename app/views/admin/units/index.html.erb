<% content_for :page_title, "Unidades" %>

<div class="w-full flex-grow flex flex-col">
  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
    <div>
      <h2 class="text-2xl font-bold text-slate-800 tracking-tight font-heading">Unidades</h2>
      <p class="text-sm text-slate-500 mt-1">Gerencie as filiais físicas do laboratório, URLs de atendimento e QR Codes.</p>
    </div>

    <div>
      <%= link_to new_admin_unit_path, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-primary hover:bg-primary-hover text-white text-sm font-semibold rounded-xl transition-all shadow-sm cursor-pointer" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
        <span>Nova Unidade</span>
      <% end %>
    </div>
  </div>

  <% if notice %>
    <div class="mb-6 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm font-semibold flex items-center justify-between">
      <span>✅ <%= notice %></span>
    </div>
  <% end %>

  <% if alert %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-800 rounded-xl text-sm font-semibold flex items-center justify-between">
      <span>⚠️ <%= alert %></span>
    </div>
  <% end %>

  <!-- Table -->
  <% if @units.any? %>
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-100 table-fixed">
          <thead class="bg-slate-50/50">
            <tr>
              <th scope="col" class="w-1/4 px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">Nome da Unidade</th>
              <th scope="col" class="w-1/6 px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">Cidade</th>
              <th scope="col" class="w-1/12 px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">Status</th>
              <th scope="col" class="w-1/3 px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">Check-in URL</th>
              <th scope="col" class="w-1/5 px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-slate-400">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% @units.each do |unit| %>
              <tr class="hover:bg-slate-50/50 transition-colors">
                <!-- Nome / Endereço -->
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold text-sm shrink-0 border border-primary/20">
                      🏢
                    </div>
                    <div class="flex flex-col min-w-0">
                      <span class="text-sm font-bold text-slate-800 truncate"><%= unit.name %></span>
                      <% if unit.address.present? %>
                        <span class="text-xs text-slate-400 truncate mt-0.5"><%= unit.address %></span>
                      <% end %>
                    </div>
                  </div>
                </td>

                <!-- Cidade -->
                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600 font-medium">
                  <%= unit.city.presence || '-' %>
                </td>

                <!-- Status -->
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if unit.active? %>
                    <span class="inline-flex items-center px-2.5 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-full text-xs font-bold">
                      Ativa
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-1 bg-red-50 text-red-700 border border-red-200 rounded-full text-xs font-bold">
                      Inativa
                    </span>
                  <% end %>
                </td>

                <!-- Check-in URL (WhatsApp / Remoto) -->
                <td class="px-6 py-4">
                  <div class="flex items-center gap-2 max-w-md">
                    <input type="text" value="<%= unit.link_url(host: request.host_with_port) %>" readonly id="unit-url-<%= unit.id %>" class="w-full px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono text-slate-600 focus:outline-none select-all truncate">
                    <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('unit-url-<%= unit.id %>').value); this.innerText = 'Copiado!'; setTimeout(() => this.innerText = 'Copiar', 2000);" class="shrink-0 px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold border border-slate-200 transition-colors cursor-pointer" title="Copiar link para WhatsApp">
                      Copiar
                    </button>
                  </div>
                </td>

                <!-- Ações -->
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to admin_unit_path(unit), class: "inline-flex items-center justify-center px-3 py-1.5 bg-secondary hover:bg-secondary-hover text-white rounded-lg text-xs font-bold transition-colors shadow-sm gap-1", title: "Ver Detalhes e QR Code" do %>
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" /></svg>
                      <span>QR Code</span>
                    <% end %>

                    <%= link_to edit_admin_unit_path(unit), class: "inline-flex items-center justify-center px-3 py-1.5 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 rounded-lg text-xs font-bold transition-colors shadow-sm gap-1", title: "Editar Unidade" do %>
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                      <span>Editar</span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl border border-slate-200 py-16 px-6 text-center shadow-sm">
      <div class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center font-bold text-xl mx-auto mb-4">
        🏢
      </div>
      <h3 class="text-base font-bold text-slate-800 font-heading">Nenhuma unidade cadastrada</h3>
      <p class="text-sm text-slate-500 mt-1 max-w-md mx-auto">Cadastre a primeira unidade física do seu laboratório para gerar o link e o QR Code de check-in.</p>
      <div class="mt-6">
        <%= link_to "+ Criar Primeira Unidade", new_admin_unit_path, class: "inline-flex items-center px-5 py-2.5 bg-primary hover:bg-primary-hover text-white text-sm font-semibold rounded-xl transition-all shadow-sm" %>
      </div>
    </div>
  <% end %>
</div>
