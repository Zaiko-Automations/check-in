<% content_for :page_title, "Nova Unidade" %>

<div class="card" style="max-width: 600px; margin: 0 auto;">
  <h2 class="text-xl font-bold text-slate-800 mb-6 font-heading border-b border-slate-100 pb-3">Criar Unidade Física</h2>

  <%= form_with model: [:admin, @unit], local: true do |f| %>
    <% if @unit.errors.any? %>
      <div style="background: #fef2f2; color: #991b1b; padding: 16px; border-radius: 8px; margin-bottom: 24px; font-size: 14px;">
        <%= @unit.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :name, "Nome da Unidade", class: "form-label" %>
      <%= f.text_field :name, class: "form-control", placeholder: "Ex: Recepção Central" %>
    </div>

    <div class="form-group">
      <%= f.label :address, "Endereço", class: "form-label" %>
      <%= f.text_field :address, class: "form-control", placeholder: "Ex: Av. Paulista, 1000" %>
    </div>

    <div class="form-group">
      <%= f.label :city, "Cidade", class: "form-label" %>
      <%= f.text_field :city, class: "form-control", placeholder: "Ex: São Paulo" %>
    </div>

    <div style="margin-top: 32px; display: flex; gap: 12px; justify-content: flex-end;">
      <%= link_to "Cancelar", admin_units_path, class: "btn btn-outline" %>
      <%= f.submit "Criar Unidade", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
