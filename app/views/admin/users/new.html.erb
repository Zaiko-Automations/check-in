<% content_for :page_title, "Novo Usuário" %>

<div class="w-full flex-grow flex flex-col">
  <!-- Page Header -->
  <div class="flex items-center gap-3 border-b border-slate-200 pb-4 mb-6">
    <%= link_to admin_users_path, class: "px-4 py-2 bg-white hover:bg-slate-50 text-slate-700 text-sm font-semibold rounded-xl border border-slate-300 transition-colors shadow-sm cursor-pointer" do %>
      ← Voltar
    <% end %>
    <h2 class="text-2xl font-bold text-slate-800 tracking-tight font-heading">Novo Usuário</h2>
  </div>

  <div class="max-w-xl bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
    <p class="text-sm text-slate-600 mb-6">
      Preencha os dados abaixo para cadastrar um novo usuário e definir sua unidade de atendimento.
    </p>

    <%= form_with model: [:admin, @user], local: true do |f| %>
      <% if @user.errors.any? %>
        <div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-800 rounded-xl text-sm">
          <%= @user.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div class="mb-4">
        <%= f.label :email, "E-mail do Usuário", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.email_field :email, placeholder: "usuario@laboratorio.com", required: true, class: "w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-secondary text-sm" %>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div>
          <%= f.label :password, "Senha", class: "block text-sm font-bold text-slate-700 mb-1" %>
          <%= f.password_field :password, placeholder: "Mínimo 6 caracteres", required: true, class: "w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-secondary text-sm" %>
        </div>
        <div>
          <%= f.label :password_confirmation, "Confirmar Senha", class: "block text-sm font-bold text-slate-700 mb-1" %>
          <%= f.password_field :password_confirmation, placeholder: "Repita a senha", required: true, class: "w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-secondary text-sm" %>
        </div>
      </div>

      <div class="mb-4">
        <%= f.label :role, "Função / Permissão", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.select :role,
                     options_for_select([["👤 Atendente — apenas visualiza a fila", "attendant"], ["🔑 Administrador — acesso total", "admin"]], @user.role || "attendant"),
                     {},
                     class: "w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-secondary text-sm" %>
        <p class="text-xs text-slate-400 mt-1">Administradores podem gerenciar usuários, unidades e configurações. Atendentes apenas visualizam e processam a fila.</p>
      </div>

      <div class="mb-6">
        <%= f.label :unit_id, "Unidade de Atendimento (opcional)", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.select :unit_id,
                     options_for_select([["Todas as Unidades (Acesso Geral)", ""]] + @units.map { |u| ["#{u.name} #{'( ' + u.city + ' )' if u.city.present?}", u.id] }, @user.unit_id),
                     {},
                     class: "w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-secondary text-sm" %>
        <p class="text-xs text-slate-400 mt-1">Restringe a visualização de pedidos apenas para a unidade selecionada. Deixe em branco para acesso geral.</p>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
        <%= link_to "Cancelar", admin_users_path, class: "px-4 py-2 text-slate-500 hover:text-slate-700 font-semibold text-sm transition-colors" %>
        <%= f.submit "Criar Usuário", class: "px-5 py-2.5 bg-secondary hover:bg-secondary-hover text-white text-sm font-bold rounded-xl transition-all shadow-md shadow-secondary/20 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
