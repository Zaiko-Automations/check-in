<% content_for :page_title, "Editar Vínculo de Atendente" %>

<div class="w-full flex-grow flex flex-col">
  <!-- Page Header -->
  <div class="flex items-center gap-3 border-b border-slate-200 pb-4 mb-6">
    <%= link_to admin_users_path, class: "px-4 py-2 bg-white hover:bg-slate-50 text-slate-700 text-sm font-semibold rounded-xl border border-slate-300 transition-colors shadow-sm cursor-pointer" do %>
      Voltar
    <% end %>
    <h2 class="text-2xl font-bold text-slate-800 tracking-tight font-heading">Vincular Unidade</h2>
  </div>

  <div class="max-w-xl bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
    <p class="text-sm text-slate-600 mb-6">
      Defina a qual unidade física o atendente <strong><%= @user.email %></strong> pertence. 
      Caso pertença a todas as unidades (ex: gerente ou super-admin), selecione <em>"Todas as Unidades (Geral)"</em>.
    </p>

    <%= form_with model: @user, url: admin_user_path(@user), method: :patch, local: true do |f| %>
      <% if @user.errors.any? %>
        <div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-800 rounded-xl text-sm">
          <%= @user.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div class="mb-6">
        <%= f.label :unit_id, "Selecione a Unidade de Atendimento", class: "block text-sm font-bold text-slate-700 mb-2" %>
        <%= f.select :unit_id, 
                     options_for_select([["Todas as Unidades (Geral / Visualização Completa)", ""]] + @units.map { |u| ["#{u.name} (#{u.city})", u.id] }, @user.unit_id), 
                     {}, 
                     class: "w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-secondary text-sm" %>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
        <%= link_to "Cancelar", admin_users_path, class: "px-4 py-2 text-slate-500 hover:text-slate-700 font-semibold text-sm transition-colors" %>
        <%= f.submit "Salvar Alterações", class: "px-5 py-2.5 bg-secondary hover:bg-secondary-hover text-white text-sm font-bold rounded-xl transition-all shadow-md shadow-secondary/20 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
